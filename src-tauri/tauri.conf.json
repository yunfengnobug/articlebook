{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArticleBook",
  "version": "0.1.4",
  "identifier": "app.articlebook.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:43123",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArticleBook",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NTE5QjFEMUU1RjE5MDAKUldRQUdWOGVIWnRSZERMRUExc2VzWmpiRE5Oa00rYzA0SFR4Ny9jNjVzbjNvZWFaeEhka0x1bnAK",
      "endpoints": [
        "https://github.com/yunfengnobug/articlebook/releases/latest/download/latest.json"
      ]
    }
  }
}
